{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "devcode",
  "description": "DevCode - AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --cwd packages/devcode dev",
    "typecheck": "bun run --cwd packages/tui typecheck",
    "test": "echo 'do not run tests from root' && exit 1"
